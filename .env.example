# Copiez ce fichier en .env puis renseignez les paramètres MySQL de WAMP.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=garten_gespann
DB_USER=root
DB_PASSWORD=

# URL de l'API PHP ; cette valeur est utilisée côté navigateur.
VITE_API_BASE_URL=http://localhost

# Origine exacte du front local, port compris.
FRONTEND_ORIGIN=http://localhost:8080

# Paiement (utilisé uniquement côté serveur, ne jamais exposer au frontend)
STRIPE_SECRET_KEY=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
PAYMENT_FALLBACK_URL=
