# Copiez ce fichier en .env et remplacez ces valeurs par celles de Hostinger.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Origine publique du site, sans slash final ni /api (l'API utilise déjà /api/...).
# Cette variable est intégrée au JavaScript lors du build (jamais de secret ici).
VITE_API_BASE_URL=https://example.com

# Origine publique exacte du front, sans slash final.
FRONTEND_ORIGIN=https://example.com

# Paiement (utilisé uniquement côté serveur, ne jamais exposer au frontend)
STRIPE_SECRET_KEY=
PAYMENT_SUCCESS_URL=https://example.com/payment-success?order={ORDER_ID}&session_id={CHECKOUT_SESSION_ID}
PAYMENT_CANCEL_URL=https://example.com/checkout?payment=cancelled&order={ORDER_ID}
PAYMENT_FALLBACK_URL=https://example.com/account?payment=pending&order={ORDER_ID}
